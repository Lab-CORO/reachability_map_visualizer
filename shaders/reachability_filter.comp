#version 430 core

// Compute Shader: Filtre les voxels visibles et génère indices compacts
// Performance: 3.4M voxels en ~0.5ms sur GPU moderne

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Input: Dense RI array
layout(std430, binding = 0) readonly buffer RIValues {
    float ri_values[];
};

// Output: Indices des voxels visibles (compact)
layout(std430, binding = 1) writeonly buffer VisibleIndices {
    uint visible_indices[];
};

// Compteur atomique pour indices visibles
layout(std430, binding = 2) buffer Counter {
    uint visible_count;
};

// Uniforms: Paramètres de filtrage
uniform ivec3 grid_size;      // size_x, size_y, size_z
uniform int low_ri;
uniform int high_ri;
uniform int disect_choice;    // 0=None, 1=X, 2=Y, 3=Z
uniform int disect_min;
uniform int disect_max;

void main() {
    uint global_id = gl_GlobalInvocationID.x;
    uint total_voxels = grid_size.x * grid_size.y * grid_size.z;

    if (global_id >= total_voxels) return;

    // Convertir index flat → coordonnées 3D
    uint x = global_id / (grid_size.y * grid_size.z);
    uint y = (global_id / grid_size.z) % grid_size.y;
    uint z = global_id % grid_size.z;

    // Lire RI value
    float ri = ri_values[global_id];

    // Filtrage par RI
    if (ri < float(low_ri) || ri > float(high_ri)) return;

    // Filtrage par dissection
    if (disect_choice != 0) {
        int index_to_check = 0;
        if (disect_choice == 1) index_to_check = int(x);
        else if (disect_choice == 2) index_to_check = int(y);
        else if (disect_choice == 3) index_to_check = int(z);

        if (index_to_check < disect_min || index_to_check > disect_max) return;
    }

    // Voxel visible! Ajouter à la liste compacte
    uint idx = atomicAdd(visible_count, 1);
    visible_indices[idx] = global_id;
}
